@{
    ViewData["Title"] = "Início";
    var destaques = (List<Objeto>)ViewBag.Destaques;
    var situacoes = (Dictionary<int, string>)ViewBag.Situacoes;
}

<section class="heroi">
    <div class="container position-relative" style="z-index:1">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="etiqueta"><i class="bi bi-stars"></i> Economia colaborativa no campus</span>
                <h1 class="mt-3 mb-4">Compartilhe o que você tem. <span>Encontre o que precisa.</span></h1>
                <p class="lead mb-4">
                    O VAI E VOLTA conecta estudantes da faculdade para emprestar livros, calculadoras, jalecos,
                    eletrônicos e tudo aquilo que passa a maior parte do tempo parado na gaveta.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a class="btn btn-laranja btn-lg" asp-controller="Objetos" asp-action="Index">
                        <i class="bi bi-search me-2"></i>Ver objetos
                    </a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="btn btn-branco btn-lg" asp-controller="Objetos" asp-action="Criar"><i class="bi bi-plus-lg me-2"></i>Anunciar objeto</a>
                    }
                    else
                    {
                        <a class="btn btn-branco btn-lg" asp-controller="Conta" asp-action="Cadastro">Criar minha conta</a>
                    }
                </div>
                <div class="numeros">
                    <div><strong>@ViewBag.TotalObjetos</strong><span>objetos cadastrados</span></div>
                    <div><strong>@ViewBag.TotalUsuarios</strong><span>estudantes</span></div>
                    <div><strong>@ViewBag.TotalEmprestimos</strong><span>empréstimos feitos</span></div>
                </div>
            </div>
            <div class="col-lg-6 d-none d-lg-block">
                <div class="mosaico">
                    @foreach (var o in destaques.Take(3))
                    {
                        <a class="mini" asp-controller="Objetos" asp-action="Detalhes" asp-route-id="@o.Id">
                            <img src="@(o.FotoUrl ?? "/img/sem-foto.svg")" alt="@o.Nome" data-fallback />
                            <p>@o.Nome</p>
                            <span class="selo selo-disponivel ms-1">Disponível</span>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<section class="secao">
    <div class="container">
        <div class="secao-titulo revelar">
            <span class="etiqueta"><i class="bi bi-lightning-charge"></i> Como funciona</span>
            <h2>Em quatro passos o objeto vai… e volta</h2>
            <p class="text-suave">Sem dinheiro envolvido: a ideia é que todo mundo se ajude dentro da faculdade.</p>
        </div>
        <div class="row g-4">
            <div class="col-md-6 col-lg-3 revelar">
                <div class="passo">
                    <span class="num">01</span>
                    <div class="icone"><i class="bi bi-camera"></i></div>
                    <h3>Anuncie</h3>
                    <p class="text-suave mb-0">Tire uma foto, escreva uma descrição e escolha a categoria do objeto que você pode emprestar.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 revelar">
                <div class="passo">
                    <span class="num">02</span>
                    <div class="icone"><i class="bi bi-search-heart"></i></div>
                    <h3>Encontre</h3>
                    <p class="text-suave mb-0">Pesquise pelo nome ou filtre por categoria para achar o que você precisa para a aula ou a prova.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 revelar">
                <div class="passo">
                    <span class="num">03</span>
                    <div class="icone"><i class="bi bi-chat-heart"></i></div>
                    <h3>Solicite</h3>
                    <p class="text-suave mb-0">Envie um pedido com a data de devolução. O dono aprova ou recusa direto pela plataforma.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 revelar">
                <div class="passo">
                    <span class="num">04</span>
                    <div class="icone"><i class="bi bi-arrow-repeat"></i></div>
                    <h3>Devolva</h3>
                    <p class="text-suave mb-0">Quando o objeto volta, o dono confirma e ele aparece de novo como disponível no catálogo.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="secao pt-0">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4 revelar">
            <div>
                <span class="etiqueta" style="background:var(--laranja-clara);color:var(--laranja-escura)"><i class="bi bi-fire"></i> Destaques</span>
                <h2 class="mt-2 mb-0">Disponíveis agora</h2>
            </div>
            <a class="btn btn-contorno" asp-controller="Objetos" asp-action="Index">Ver todos <i class="bi bi-arrow-right ms-1"></i></a>
        </div>
        @if (destaques.Count == 0)
        {
            <div class="vazio"><div class="icone"><i class="bi bi-box-seam"></i></div><h4>Nenhum objeto disponível no momento</h4></div>
        }
        <div class="row g-4">
            @foreach (var o in destaques)
            {
                <div class="col-sm-6 col-lg-4 revelar">
                    <partial name="_CardObjeto" model='(o, situacoes.GetValueOrDefault(o.Id, "Disponível"))' />
                </div>
            }
        </div>
    </div>
</section>

<section class="pb-2">
    <div class="container">
        <div class="faixa-cta revelar">
            <div class="row align-items-center g-4 position-relative" style="z-index:1">
                <div class="col-lg-8">
                    <h2 class="mb-2">Tem algo parado na gaveta?</h2>
                    <p class="mb-0 fs-5" style="color:#fff3ea">Aquele livro do semestre passado pode salvar a prova de alguém hoje.</p>
                </div>
                <div class="col-lg-4 text-lg-end">
                    <a class="btn btn-branco btn-lg" asp-controller="Objetos" asp-action="Criar"><i class="bi bi-plus-lg me-2"></i>Anunciar um objeto</a>
                </div>
            </div>
        </div>
    </div>
</section>
