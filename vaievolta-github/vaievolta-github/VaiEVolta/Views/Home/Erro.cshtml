@{
    int codigo = ViewBag.Codigo;
    var (titulo, texto, icone) = codigo switch
    {
        404 => ("Página não encontrada", "O endereço que você procurou não existe ou o objeto foi removido.", "bi-signpost-split"),
        403 => ("Acesso negado", "Você não tem permissão para ver esta página.", "bi-shield-lock"),
        _ => ("Algo deu errado", "Tivemos um problema ao processar sua solicitação. Tente de novo em instantes.", "bi-bug")
    };
    ViewData["Title"] = titulo;
}
<div class="container secao">
    <div class="vazio">
        <div class="icone"><i class="bi @icone"></i></div>
        <p class="text-laranja fw-bold mb-1">Erro @codigo</p>
        <h1 class="h2">@titulo</h1>
        <p class="text-suave mx-auto" style="max-width:460px">@texto</p>
        <div class="d-flex gap-2 justify-content-center mt-4">
            <a class="btn btn-marinho" asp-controller="Home" asp-action="Index"><i class="bi bi-house me-1"></i> Voltar ao início</a>
            <a class="btn btn-contorno" asp-controller="Objetos" asp-action="Index">Ver objetos</a>
        </div>
        @if (codigo >= 500)
        {
            <p class="small text-suave mt-4">Código de rastreio: @ViewBag.Rastreio</p>
        }
    </div>
</div>
